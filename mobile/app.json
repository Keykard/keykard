{
  "expo": {
    "name": "KEYKARD",
    "slug": "keykard",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "keykard",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keykard.app"
    },
    "android": {
      "package": "com.keykard.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.keykard.xyz",
              "pathPrefix": "/card"
            },
            {
              "scheme": "https",
              "host": "www.keykard.xyz",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "keycard-eight.vercel.app",
              "pathPrefix": "/card"
            },
            {
              "scheme": "https",
              "host": "keycard-eight.vercel.app",
              "pathPrefix": "/g/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# native modules looked up by name (JNI / reflection)\n-keep class com.margelo.nitro.** { *; }\n-keep class com.reactnativepasskey.** { *; }\n-keep class community.revteltech.nfc.** { *; }\n# Credential Manager (passkeys) via Play services\n-if class androidx.credentials.CredentialManager\n-keep class androidx.credentials.playservices.** { *; }\n-keep class androidx.credentials.** { *; }\n-dontwarn com.google.android.gms.**"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "KEYKARD uses the camera to scan a merchant's QR code.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "KEYKARD reads your physical KEYKARD card to link it and to take payments."
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://keycard-production-da41.up.railway.app"
    }
  }
}